Algoritmo vectores1
	Definir num como numero
	Dimensionar vector[5];
	Para c<-0 Hasta 4 Con Paso 1 Hacer
		Mostrar "Ingrese el valor del ", c+1, " numero";
		Leer num;
		vector[c] = num;
	Fin Para
	Para c <-0 Hasta 4 Con Paso 1 Hacer
		Mostrar Sin Saltar vector[c], " ";
	Fin Para
FinAlgoritmo
